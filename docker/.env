# ===== Windchill =====
WC_HOSTNAME=windchill.local
WC_HTTP_PORT=8080
SOLR_PORT=8085
CORRETTO_VERSION=21.0.9.11.1
WC_XMX=8g

# Commande d'installation silencieuse PTC (à adapter à votre média 13.1.x.x)
# Le média est monté dans /opt/ptc-media ; la cible d'installation est /opt/ptc
PSI_INSTALL_CMD=/opt/ptc-media/setup.sh -display :0 -i silent -f /opt/ptc-scripts/hooks/psi-response.properties
DISPLAY=host.docker.internal:0.0
PSI_INSTALL_CMD_UI=sudo /opt/ptc-media/setup -display $DISPLAY LAX_VM /usr/lib/jvm/corretto-21/bin/java
LAX_DEBUG_VERBOSE=
LAX_DEBUG=1


